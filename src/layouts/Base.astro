---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Door from '../components/Door.astro';
import { alternates, type Lang, type RouteKey } from '../routes';
import { t } from '../i18n';

interface Props {
  lang: Lang; title: string; description: string; route: RouteKey; params?: Record<string, string>;
  ogImage?: string; ogImageAlt?: string; ogType?: 'website' | 'article'; noindex?: boolean; ground?: 'forest' | 'canopy' | 'linen' | 'shade'; jsonLd?: object | object[]; bodyClass?: string;
  // The page's own address in each language, when the two slugs differ (the guides).
  alt?: Record<Lang, string>;
}
const { lang, title, description, route, params = {}, ogImage, ogImageAlt, ogType = 'website', noindex = false, ground = 'forest', jsonLd, bodyClass = '', alt: altProp } = Astro.props;
const site = Astro.site ?? new URL('https://jjfcreando.com');
const alt = altProp ?? alternates(route, params);
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(alt[lang]);
// A real square mark, not the Spanish social card that was being served to English pages too.
// The @id gives every page's graph one node to point at instead of repeating the organisation.
const siteData = (await getCollection('site')).find((s) => s.data.lang === lang)!.data;
const staging = import.meta.env.PUBLIC_STAGING === '1';
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': abs('/#org'),
  name: 'JJF Creando',
  url: abs('/'),
  logo: abs('/brand/logo.png'),
  areaServed: ['Tulum', 'Quintana Roo', 'Yucatán', 'México'],
  address: { '@type': 'PostalAddress', addressLocality: 'Tulum', addressRegion: 'Quintana Roo', addressCountry: 'MX' },
  ...(siteData.whatsapp.verified ? { telephone: siteData.whatsapp.number.replace(/\s/g, '') } : {}),
  ...(siteData.email ? { email: siteData.email } : {}),
  ...(siteData.social.length ? { sameAs: siteData.social.map((s) => s.url) } : {}),
};
// A page may bring more than one node (a project brings its Residence and its breadcrumb);
// they join the organisation in one flat graph rather than nesting an array inside an array.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: 'JJF Creando',
  inLanguage: ['es-MX', 'en'],
  publisher: { '@id': abs('/#org') },
};
const own = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Every page names itself once. A view that brings its own WebPage (with a date) keeps it.
const hasPage = own.some((n: any) => n['@type'] === 'WebPage');
const webPage = hasPage ? [] : [{
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description,
  inLanguage: lang === 'es' ? 'es-MX' : 'en', isPartOf: { '@id': abs('/#website') },
}];
const ld = [org, website, ...webPage, ...own];
---
<!doctype html>
<html lang={lang === 'es' ? 'es-MX' : 'en'} data-ground={ground} data-lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-MX" href={abs(alt.es)} />
    <link rel="alternate" hreflang="en" href={abs(alt.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alt.es)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="JJF Creando" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage ?? `/og/default-${lang}.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={(ogImage ?? '.png').endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0A0D0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />
    <script is:inline>
      // The door (plan §S0): once per browser session, never under reduced motion, never without JS.
      document.documentElement.classList.add('js');
      try {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!sessionStorage.getItem('jjf-door') && !reduce) { document.documentElement.classList.add('door-pending'); sessionStorage.setItem('jjf-door', '1'); }
        if (localStorage.getItem('jjf-seen')) document.documentElement.classList.add('returning');
      } catch (e) {}
    </script>
    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class={bodyClass} data-staging={staging ? '1' : undefined}>
    <Door />
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <Nav lang={lang} route={route} params={params} alt={alt} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script src="../scripts/app.ts"></script>
  </body>
</html>
