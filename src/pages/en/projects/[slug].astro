---
import { getCollection } from 'astro:content';
import Project from '../../../views/Project.astro';
export async function getStaticPaths() {
  const entries = await getCollection('projects', (e) => e.data.lang === 'en' && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Project lang="en" entry={entry} />
