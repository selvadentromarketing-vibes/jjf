---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { href, type Lang } from '../routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = (await getCollection('site')).find((s) => s.data.lang === lang)!.data;
const entry = (await getCollection('how')).find((e) => e.data.lang === lang)!;
const { Content } = await render(entry);
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: (entry.body ?? '').split(/^## /m).slice(1).map((s) => { const [q, ...a] = s.trim().split('\n'); return { '@type': 'Question', name: q.trim(), acceptedAnswer: { '@type': 'Answer', text: a.join(' ').trim() } }; }) };
// This page answers the questions in a paragraph each; the guides answer four of them at length.
// It is the natural place to hand a reader over, and the only route into the guides from the
// answer they arrived for.
const guides = (await getCollection('guides', (e) => e.data.lang === lang && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const abs = (p: string) => new URL(p, Astro.site ?? 'https://jjfcreando.com').href;
const jsonLd = [
  faq,
  // A dated page is a page an assistant can tell you how old it is. Every figure here is one a
  // notary can change, so the date is the point.
  { '@context': 'https://schema.org', '@type': 'WebPage', name: entry.data.title, description: site.pages.how.description, url: abs(href('how', lang)), inLanguage: lang === 'es' ? 'es-MX' : 'en', dateModified: entry.data.asOf },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'JJF Creando', item: abs(href('home', lang)) },
      { '@type': 'ListItem', position: 2, name: entry.data.title, item: abs(href('how', lang)) },
    ],
  },
];
---
<Base lang={lang} title={site.pages.how.title} description={site.pages.how.description} route="how" ground="linen" jsonLd={jsonLd}>
  <article class="page" data-ground="linen">
    <header class="page-head">
      <h1 class="display">{entry.data.title}</h1>
      <p class="measure">{entry.data.intro}</p>
    </header>
    <div class="prose"><Content /></div>
    <p class="note">{t(lang, 'how.confirm')}</p>
    {guides.length > 0 && (
      <nav class="guide-related" aria-label={t(lang, 'guides.forHow')}>
        <p class="caption">{t(lang, 'guides.forHow')}</p>
        {guides.map((g) => <a href={href('guide', lang, { slug: g.data.key })}>{g.data.title}</a>)}
      </nav>
    )}
  </article>
</Base>
