---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import type { Lang } from '../routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = (await getCollection('site')).find((s) => s.data.lang === lang)!.data;
const entry = (await getCollection('how')).find((e) => e.data.lang === lang)!;
const { Content } = await render(entry);
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: (entry.body ?? '').split(/^## /m).slice(1).map((s) => { const [q, ...a] = s.trim().split('\n'); return { '@type': 'Question', name: q.trim(), acceptedAnswer: { '@type': 'Answer', text: a.join(' ').trim() } }; }) };
---
<Base lang={lang} title={site.pages.how.title} description={site.pages.how.description} route="how" ground="linen" jsonLd={faq}>
  <article class="page" data-ground="linen">
    <header class="page-head">
      <h1 class="display">{entry.data.title}</h1>
      <p class="measure">{entry.data.intro}</p>
    </header>
    <div class="prose"><Content /></div>
    <p class="note">{t(lang, 'how.confirm')}</p>
  </article>
</Base>
