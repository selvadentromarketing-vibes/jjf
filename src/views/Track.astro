---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { href, type Lang } from '../routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = (await getCollection('site')).find((s) => s.data.lang === lang)!.data;
const projects = (await getCollection('projects', (e) => e.data.lang === lang && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);

// A column earns its place only if at least one project has verified data for it. Rendering the
// headings unconditionally produced six rows of em-dashes, which reads as a table that failed to
// load rather than as a deliberate refusal to publish unverified figures. The page now shows what
// is actually known, and each column reappears by itself the moment a figure is signed off.
const years = (p: (typeof projects)[number]) =>
  p.data.years?.verified ? `${p.data.years.start}${p.data.years.end ? `–${p.data.years.end}` : ''}` : '';

const COLUMNS = [
  { key: 'status', head: t(lang, 'track.status'), value: (p: (typeof projects)[number]) => (p.data.statusVerified && p.data.statusLabel) || '' },
  { key: 'years', head: t(lang, 'track.years'), value: years },
  { key: 'hectares', head: t(lang, 'track.hectares'), value: (p: (typeof projects)[number]) => (p.data.hectares?.verified ? String(p.data.hectares.value) : '') },
].filter((col) => projects.some((p) => col.value(p) !== ''));
---
<Base lang={lang} title={site.pages.track.title} description={site.pages.track.description} route="track" ground="linen">
  <article class="page" data-ground="linen">
    <header class="page-head">
      <h1 class="display">{t(lang, 'ledger.title')}</h1>
      <p class="note">{t(lang, 'track.note')}</p>
    </header>
    <div style="overflow-x:auto">
      <table class="ledger-table" data-figures-ok>
        <thead>
          <tr>
            <th>{t(lang, 'track.place')}</th>
            <th>{t(lang, 'track.where')}</th>
            <th>{t(lang, 'track.character')}</th>
            {COLUMNS.map((c) => <th>{c.head}</th>)}
          </tr>
        </thead>
        <tbody>
          {projects.map((p) => (
            <tr>
              <td><a href={href('project', lang, { slug: p.data.key })}>{p.data.name}</a></td>
              <td class="dim">{p.data.place}</td>
              <td class="dim">{p.data.character}</td>
              {COLUMNS.map((c) => <td class="dim">{c.value(p) || '—'}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>
</Base>
