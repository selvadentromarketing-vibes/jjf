---
// A place, as a sequence of scenes.
//
// The record used to arrive as a thousand words in a column. It is now a page: the photograph
// with the camera moving, the answer-first statement in display type with the two things you can
// do, one bar of facts, then each chapter as a scene — title and text on alternating sides of a
// twelve-column grid, the master plan inside the chapter about the plan, the chapter about living
// here opening in display type — then the questions on rock, the doors on the page, and the next
// place as a photograph you can step into. Each place has one photograph; it is never repeated
// mid-page as a "detail".
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Plano from '../components/Plano.astro';
import Facts from '../components/Facts.astro';
import Doors from '../components/Doors.astro';
import Silence from '../components/Silence.astro';
import { t } from '../i18n';
import { href, type Lang } from '../routes';
import { parseRecord, inline } from '../lib/record';
interface Props { lang: Lang; entry: CollectionEntry<'projects'> }
const { lang, entry } = Astro.props;
const p = entry.data;
const all = (await getCollection('projects', (e) => e.data.lang === lang && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.data.key === p.key);
const next = all[(idx + 1) % all.length];
const site = (await getCollection('site')).find((s) => s.data.lang === lang)!.data;
const guides = (await getCollection('guides', (e) => e.data.lang === lang && !e.data.draft))
  .filter((g) => g.data.related.includes(p.key))
  .sort((a, b) => a.data.order - b.data.order);
const staging = import.meta.env.PUBLIC_STAGING === '1';
const usable = (e: CollectionEntry<'projects'>) => (e.data.hero && (!e.data.heroStaging || staging) ? e.data.hero : undefined);
const plate = usable(entry);
const nextPlate = usable(next);
// The master plan is the drawing a buyer zooms into. Scaled into a phone it is unreadable, and the
// plan bans modals, so the figure links to the full image and the browser's own viewer does the
// pinching — no script, and it works offline of us.
const masterplanFull = p.masterplan ? await getImage({ src: p.masterplan, format: 'webp', quality: 88 }) : undefined;
// The card a shared link unfurls: the plate where one is publishable, the typographic card where
// it is not. Never black (§11).
const ogImage = plate
  ? (await getImage({ src: plate, width: 1200, height: 630, fit: 'cover', position: 'center', format: 'jpeg', quality: 76 })).src
  : undefined;
// WhatsApp opens on this place by name. Shown only once the number is verified, or on staging.
const showWa = site.whatsapp.verified || staging;
const wa = showWa ? `https://wa.me/${site.whatsapp.number.replace(/\D/g, '')}?text=${encodeURIComponent(t(lang, 'doors.waText', { project: p.name }))}` : undefined;
const url = new URL(href('project', lang, { slug: p.key }), Astro.site ?? 'https://jjfcreando.com').href;
const abs = (path: string) => new URL(path, Astro.site ?? 'https://jjfcreando.com').href;
// The body, as chapters: the closing "Preguntas" / "Questions" chapter is the page's FAQ.
const faqHead = lang === 'es' ? 'Preguntas' : 'Questions';
const chapters = parseRecord(entry.body ?? '', faqHead);
const prose = chapters.filter((c) => !c.faq);
const faqChapter = chapters.find((c) => c.faq);
const faq = (faqChapter?.qa ?? []).map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } }));
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Residence', name: p.name, url, description: `${p.place} · ${p.character}`,
    address: { '@type': 'PostalAddress', addressLocality: p.locality, addressRegion: p.region, addressCountry: 'MX' },
    ...(p.coordinates ? { geo: { '@type': 'GeoCoordinates', latitude: p.coordinates.lat, longitude: p.coordinates.lng } } : {}),
    ...(p.siteUrl ? { sameAs: [p.siteUrl] } : {}),
    ...(p.summary ? { description: p.summary } : {}),
  },
  ...(faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq }] : []),
  ...(p.updated ? [{ '@context': 'https://schema.org', '@type': 'WebPage', url, dateModified: p.updated, inLanguage: lang === 'es' ? 'es-MX' : 'en', about: { '@type': 'Residence', name: p.name } }] : []),
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'JJF Creando', item: abs(href('home', lang)) },
      { '@type': 'ListItem', position: 2, name: t(lang, 'projects.all'), item: abs(href('projects', lang)) },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---
<Base lang={lang} title={`${p.name} — JJF Creando`} description={p.summary ?? `${p.place} · ${p.character}`} route="project" params={{ slug: p.key }} ground="linen" jsonLd={jsonLd} bodyClass="page-project" ogImage={ogImage} ogImageAlt={plate ? p.heroAlt : undefined}>
  <article class="project" data-project-page={p.key}>
    <div data-ground="linen">
      <header class:list={['project-hero', { 'has-plano': !!p.plan, 'has-plate': !!plate }]} data-light={p.lightMode}>
        <div class="hero-sink">
          <Plano slug={p.key} plan={p.plan} />
          {plate && <Picture class="hero-plate" pictureAttributes={{ class: 'hero-media' }} src={plate} widths={[640, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" alt={p.heroAlt} loading="eager" fetchpriority="high" decoding="async" />}
        </div>
        <div class="project-title">
          <p class="eyebrow">{p.place}</p>
          <h1 class="display">{p.name}</h1>
          <p class="hero-line">{p.character}</p>
          <a class="folio-marker" href={href('projects', lang)} data-figures-ok aria-label={t(lang, 'projects.all')}>{String(idx + 1).padStart(2, '0')}/{String(all.length).padStart(2, '0')}</a>
        </div>
      </header>

      {p.summary && (
        <section class="statement grid12">
          <p class="statement-text" data-reveal="rise">{p.summary}</p>
          <div class="statement-act btn-row" data-reveal="fade" style="--i:1">
            <a class="btn btn-primary" href="#hablemos" data-event="cta_click" data-section="statement" data-project={p.key}>{t(lang, 'project.talk', { name: p.name })}</a>
            {wa && <a class="btn" href={wa} target="_blank" rel="noopener" data-event="whatsapp_click" data-section="statement" data-wa-project={p.key}>{t(lang, 'doors.whatsapp')}</a>}
          </div>
        </section>
      )}
      <Facts lang={lang} project={p} />

      {prose.map((c, i) => (
        <section class:list={['scene', 'grid12', { alt: i % 2 === 1 && i !== 3, quote: i === 3, last: i === prose.length - 1 }]} id={c.slug}>
          {i === 3 ? (
            <>
              <h2 class="display scene-title" data-reveal="lines"><span class="line"><span>{c.title}</span></span></h2>
              <p class="scene-quote" data-reveal="rise" set:html={inline(c.paragraphs[0] ?? '')} />
              <div class="scene-cols">{c.paragraphs.slice(1).map((para, j) => <p data-reveal="rise" style={`--i:${Math.min(j + 1, 3)}`} set:html={inline(para)} />)}</div>
            </>
          ) : (
            <>
              <h2 class="display scene-title" data-reveal="lines"><span class="line"><span>{c.title}</span></span></h2>
              <div class="scene-text">{c.paragraphs.map((para, j) => <p data-reveal="rise" style={`--i:${Math.min(j, 3)}`} set:html={inline(para)} />)}</div>
            </>
          )}
          {i === 2 && p.masterplan && (
            <figure class="scene-figure masterplan">
              <figcaption class="caption" data-reveal="fade">{t(lang, 'project.masterplan')}{p.sellsVerified && p.sells && ` · ${t(lang, `sells.${p.sells}` as any)}`}{p.availability && ` · ${p.availability}`}</figcaption>
              <a href={masterplanFull!.src} class="masterplan-open scene-img" target="_blank" rel="noopener" data-reveal="image">
                <div class="img-wrap">
                  <Picture src={p.masterplan} widths={[640, 1280, 1920]} sizes="(min-width: 1024px) 84vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" alt={t(lang, 'project.masterplanAlt', { name: p.name })} loading="lazy" />
                </div>
                <span class="masterplan-hint">{t(lang, 'project.masterplanOpen')}</span>
              </a>
            </figure>
          )}
        </section>
      ))}
    </div>

    <div class="project-tail" data-ground="shade">
      {faq.length > 0 && (
        <section class="project-faq" id="preguntas">
          <h2 class="display">{faqChapter!.title}</h2>
          <dl class="faq-list">
            {faqChapter!.qa.map((x) => <div class="faq-item"><dt>{x.q}</dt><dd set:html={inline(x.a)} /></div>)}
          </dl>
        </section>
      )}
      <section class="project-act" id="hablemos">
        <div class="act-head">
          <h2 class="display">{t(lang, 'project.talk', { name: p.name })}</h2>
          <p class="act-lede">{t(lang, 'project.actLede')}</p>
        </div>
        <Doors lang={lang} site={site} projects={all} />
      </section>
      {guides.length > 0 && (
        <nav class="guide-related project-guides" aria-label={t(lang, 'guides.forPlace')}>
          <p class="caption">{t(lang, 'guides.forPlace')}</p>
          {guides.map((g) => <a href={href('guide', lang, { slug: g.data.key })}>{g.data.title}</a>)}
        </nav>
      )}
      {nextPlate ? (
        <a class="next-scene" href={href('project', lang, { slug: next.data.key })} data-event="project_open" data-section="next" data-project={next.data.key}>
          <div class="scene-img" data-reveal="image">
            <div class="img-wrap">
              <Picture src={nextPlate} widths={[640, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" alt="" loading="lazy" decoding="async" />
            </div>
          </div>
          <span class="next-copy"><span class="caption">{t(lang, 'project.next')}</span><span class="display name">{next.data.name}</span></span>
        </a>
      ) : (
        <p class="project-next"><span class="caption">{t(lang, 'project.next')}</span><a href={href('project', lang, { slug: next.data.key })}>{next.data.name}</a></p>
      )}
    </div>
  </article>
  <Silence sentences={p.closingSentence} signature={site.signature} />
</Base>
