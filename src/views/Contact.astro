---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Doors from '../components/Doors.astro';
import { t } from '../i18n';
import { href, type Lang } from '../routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = (await getCollection('site')).find((s) => s.data.lang === lang)!.data;
const projects = (await getCollection('projects', (e) => e.data.lang === lang && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base lang={lang} title={site.pages.contact.title} description={site.pages.contact.description} route="contact" ground="shade" bodyClass="contact-page">
  <section class="page">
    <header class="page-head">
      <h1 class="display" data-reveal="lines"><span class="line"><span>{site.invitation}</span></span></h1>
      <p class="contact-ledger">{t(lang, 'contact.ledgerLine')} <a href={href('track', lang)}>{t(lang, 'ledger.more')}</a></p>
    </header>
    <Doors lang={lang} site={site} projects={projects} />
  </section>
</Base>
