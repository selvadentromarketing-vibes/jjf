---
import { t } from '../i18n';
import { href, type Lang } from '../routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer class="footer" data-figures-ok>
  <p>JJF Creando</p>
  <p>{t(lang, 'footer.place')}</p>
  <nav class="footer-links" aria-label={t(lang, 'footer.nav')}>
    <a href={href('projects', lang)}>{t(lang, 'nav.projects')}</a>
    <a href={href('vision', lang)}>{t(lang, 'nav.vision')}</a>
    <a href={href('track', lang)}>{t(lang, 'nav.track')}</a>
    <a href={href('how', lang)}>{t(lang, 'nav.how')}</a>
    <a href={href('contact', lang)}>{t(lang, 'nav.contact')}</a>
  </nav>
  <p><a href={href('privacy', lang)}>{t(lang, 'footer.privacy')}</a></p>
</footer>
