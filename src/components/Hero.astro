---
// Dosel (plan §S1, revised 16 September). The hero is the studio's opening, and the camera moves.
//
// Three layers in one grid cell, all in the same coordinates. The plate is the first frame of the
// founder's film — a printed master plan on a table, half under tracing paper — and paints first,
// in flow, as the LCP element; it is the whole hero wherever the film cannot play. Over it, when a
// place is selling, El Plano: that place's plan traced from this very frame, drawn in dash-dot so
// every drawn line sits on a printed one. Then the film itself, which starts on the plate's frame
// (the cut is invisible), so the hand that pulls the paper away pulls it from under the drawing;
// after the table the film goes on into the land and loops there (hero.ts, plano.ts).
// The plate keeps no camera move of its own here: any scale would break the registration and jump
// at the cut. The <picture> is the grid item, in flow, with no wrapper box between it and the grid —
// Chrome drops the image from its largest-contentful-paint candidates when a plain div sits in
// between (measured), and the box is one pixel short of the hero for the same reason (global.css).
//
// Over the land, four things: who this is and what is happening now (one line), the studio's own
// sentence, the lede, and the things you can do. The selling place is named, not sold: its page and
// WhatsApp; the sales doors have a stratum of their own further down.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import plate from '../assets/img/hero-table.webp';
import Plano from './Plano.astro';
import { t } from '../i18n';
import { href, type Lang } from '../routes';
interface Props { lang: Lang; headline: string[]; lede: string; project?: CollectionEntry<'projects'>; wa?: string }
const { lang, headline, lede, project, wa } = Astro.props;
const p = project?.data;
const plan = p?.plan;
// The film's land loop begins here (seconds): after the table, never back to it (hero.ts).
const LOOP_IN = 4.42;
// Largest Contentful Paint: Chrome scores an image by the smaller of its natural and its displayed
// area and replaces the candidate only with a strictly larger one. The plate is wider than a screen
// (2.2:1) and covers it, so the candidate the browser picks has to be about 1.12× the viewport
// wide for its natural area to match the box; `sizes` asks for that on a desk, and the film's box
// is a pixel shorter than the plate's, so the plate stays the element that is scored (hero.spec).
---
<section class:list={['hero', 'stratum', { 'has-plano': !!plan, 'has-plate': true }]} data-stratum="dosel" data-ground="canopy" data-light="A" id="dosel" data-plano-host={plan ? '' : undefined} data-plano-hold={plan ? 'film' : undefined}>
  <Picture class="hero-plate" pictureAttributes={{ class: 'hero-media' }} src={plate} widths={[640, 960, 1200, 1600, 1920]} sizes="(min-width: 1024px) 112vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" alt="" loading="eager" fetchpriority="high" decoding="async" />
  <video class="hero-video" muted playsinline preload="none" tabindex="-1" aria-hidden="true" data-hero-video data-loop-in={LOOP_IN}>
    <source data-src="/media/hero/hero-desk.webm" type="video/webm; codecs=av01.0.08M.08" media="(min-width: 1024px)" />
    <source data-src="/media/hero/hero-desk.mp4" type="video/mp4; codecs=avc1.640028" media="(min-width: 1024px)" />
    <source data-src="/media/hero/hero-phone.webm" type="video/webm; codecs=av01.0.05M.08" />
    <source data-src="/media/hero/hero-phone.mp4" type="video/mp4; codecs=avc1.64001f" />
  </video>
  {p && plan && <Plano slug={p.key} plan={plan} />}
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-tint" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow hero-el" data-reveal="fade" style="--i:0">{p ? t(lang, 'hero.eyebrowNow', { name: p.name }) : t(lang, 'hero.eyebrow')}</p>
    <h1 class="display hero-title hero-el" data-reveal="lines">
      {headline.map((l, i) => <span class="line" style={`--i:${i}`}><span set:html={l} /></span>)}
    </h1>
    <p class="lede hero-el" data-reveal="fade" style="--i:3" set:html={lede} />
    <div class="hero-act btn-row hero-el" data-reveal="fade" style="--i:4">
      {p ? (
        <>
          <a class="btn btn-primary" href={href('project', lang, { slug: p.key })} data-event="project_open" data-section="hero" data-project={p.key}>{t(lang, 'hero.seePlace', { name: p.name })}</a>
          {wa && <a class="btn" href={wa} target="_blank" rel="noopener" data-event="whatsapp_click" data-section="hero" data-project={p.key}>{t(lang, 'doors.whatsapp')}</a>}
        </>
      ) : (
        <>
          <a class="btn btn-primary" href={href('projects', lang)} data-event="cta_click" data-section="hero">{t(lang, 'hero.see')}</a>
          <a class="btn" href={href('contact', lang)} data-event="cta_click" data-section="hero">{t(lang, 'nav.talk')}</a>
        </>
      )}
    </div>
  </div>
  <div class="hero-cue" aria-hidden="true"><span class="cue-label">{t(lang, 'hero.cue')}</span><span class="cue-line"><span></span></span></div>
</section>
