---
// Dosel (plan §S1, revised 15 September). The hero is the land, and the camera moves.
//
// Two layers. The plate — JJF's own aerial, the jungle with its cenote — paints first, in flow, as
// the LCP element, and is the whole hero wherever the film cannot play. The film is the founder's
// own hero cut (1080p, five shots), slowed to half speed, its letterbox and burned-in subtitles
// cropped away, looped through a dissolve; it is fetched only after the page has loaded and fades
// in once the plate has finished arriving. The motion under it is the camera's: an arrival that
// comes into focus and settles, a slow drift while you look, a sink as you scroll.
// None of it needs a script, and the plate is still painted first, in flow, as the LCP element —
// with the <picture> itself as the grid item. A plain wrapper box between the grid and the image
// takes the image out of Chrome's largest-contentful-paint candidates entirely (measured: the same
// file, same size, same position is a candidate as a grid item and is not inside a div), so the
// three camera moves share two elements: the picture sinks on scroll; the image arrives, then
// breathes, the second animation starting the moment the first has finished.
import { Picture } from 'astro:assets';
import plate from '../assets/img/hero-bg.webp';
interface Props { headline: string[]; lede: string }
const { headline, lede } = Astro.props;
---
<section class="hero stratum" data-stratum="dosel" data-ground="canopy" data-light="A" id="dosel">
  <Picture class="hero-plate" pictureAttributes={{ class: 'hero-media' }} src={plate} widths={[640, 960, 1200, 1400]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" alt="" loading="eager" fetchpriority="high" decoding="async" />
  <video class="hero-video" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" data-hero-video>
    <source data-src="/media/hero/hero-desk.webm" type="video/webm; codecs=av01.0.08M.08" media="(min-width: 1024px)" />
    <source data-src="/media/hero/hero-desk.mp4" type="video/mp4; codecs=avc1.640028" media="(min-width: 1024px)" />
    <source data-src="/media/hero/hero-phone.webm" type="video/webm; codecs=av01.0.05M.08" />
    <source data-src="/media/hero/hero-phone.mp4" type="video/mp4; codecs=avc1.64001f" />
  </video>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-tint" aria-hidden="true"></div>
  <div class="hero-copy">
    <h1 class="display hero-title hero-el" data-reveal="lines">
      {headline.map((l, i) => <span class="line" style={`--i:${i}`}><span set:html={l} /></span>)}
    </h1>
    <p class="lede hero-el" data-reveal="fade" style="--i:3" set:html={lede} />
  </div>
  <div class="hero-cue" aria-hidden="true"><span></span></div>
</section>
