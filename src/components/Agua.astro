---
// Agua: the water table. The invitation and the doors stand on it.
//
// The plan wanted a photograph here — a cenote at water level — and the lid of rock above
// scrolling off it. That plate was never commissioned, so the surface is drawn: a gradient ground
// with caustics computed over it where the device can carry them. The ledger that used to sit
// here was the index again, six names for the third time on one page; the stratum is now only
// the thing it is for — being received.
import type { CollectionEntry } from 'astro:content';
import Doors from './Doors.astro';
import type { Lang } from '../routes';
interface Props { lang: Lang; site: CollectionEntry<'site'>['data']; projects: CollectionEntry<'projects'>[] }
const { lang, site, projects } = Astro.props;
---
<section class="agua stratum" data-stratum="agua" data-ground="forest" id="agua">
  <div class="agua-water" data-light="D" data-light-blend="screen" aria-hidden="true"></div>
  <h2 class="display invitation" data-reveal="lines"><span class="line"><span>{site.invitation}</span></span></h2>
  <Doors lang={lang} site={site} projects={projects} />
</section>
