---
// Ahora: the one place that is selling, between the daylight and the archive of six. The index
// treats the six as equals on purpose; this is where the site says which door is open today, with
// the photograph across the page and the two things a buyer can do. It renders only for a project
// whose status is set to en-venta by the record — not a figure, an editorial state — and goes away
// by itself the day that flag changes.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t } from '../i18n';
import { href, type Lang } from '../routes';
interface Props { lang: Lang; project: CollectionEntry<'projects'>; line: string; wa?: string }
const { lang, project, line, wa } = Astro.props;
const p = project.data;
const staging = import.meta.env.PUBLIC_STAGING === '1';
const plate = p.hero && (!p.heroStaging || staging) ? p.hero : undefined;
---
<section class="now stratum" data-stratum="ahora" data-ground="canopy" id="ahora">
  {plate && (
    <div class="now-plate scene-img" data-reveal="image">
      <div class="img-wrap">
        <Picture src={plate} widths={[640, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="webp" alt={p.heroAlt} loading="lazy" decoding="async" />
      </div>
    </div>
  )}
  <div class="now-copy">
    <p class="eyebrow" data-reveal="fade">{t(lang, 'now.eyebrow')}</p>
    <h2 class="display" data-reveal="lines"><span class="line"><span>{p.name}</span></span></h2>
    <p class="now-line" data-reveal="rise" style="--i:1">{line}</p>
    <div class="btn-row" data-reveal="fade" style="--i:2">
      <a class="btn btn-primary" href={href('project', lang, { slug: p.key })} data-event="project_open" data-section="now" data-project={p.key}>{t(lang, 'now.see', { name: p.name })}</a>
      {wa && <a class="btn" href={wa} target="_blank" rel="noopener" data-event="whatsapp_click" data-section="now" data-wa-project={p.key}>{t(lang, 'doors.whatsapp')}</a>}
    </div>
  </div>
</section>
