---
// The bridge from a place to the buying process (plan §3: reassurance in words, not badges).
//
// A buyer reading about one development immediately has questions that have nothing to do with
// that development — can a foreigner buy at all, what is a fideicomiso, who is the notary. Those
// answers already exist on /como-se-compra/, but nothing led anyone there from the page where the
// question actually occurs to them, so the page ended on an invitation to talk with the doubt
// still unanswered.
//
// The questions are taken in authored order rather than hand-picked per project: the content is
// written most-fundamental first, and taking the first few means reordering or rewriting that page
// never leaves a stale list behind here.
import { getCollection, render } from 'astro:content';
import { t } from '../i18n';
import { href, type Lang } from '../routes';

interface Props { lang: Lang; count?: number }
const { lang, count = 5 } = Astro.props;

const entry = (await getCollection('how')).find((e) => e.data.lang === lang);
const headings = entry ? (await render(entry)).headings.filter((h) => h.depth === 2).slice(0, count) : [];
const page = href('how', lang);
---
{headings.length > 0 && (
  <section class="preguntas">
    <p class="caption">{t(lang, 'questions.eyebrow')}</p>
    <ul class="pregunta-list" role="list">
      {headings.map((h) => (
        <li><a href={`${page}#${h.slug}`}>{h.text}</a></li>
      ))}
    </ul>
    <a class="pregunta-all" href={page}>{t(lang, 'questions.all')}</a>
  </section>
)}
