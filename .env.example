# Copy to .env for local work. Netlify: set these in Site configuration → Environment variables.
PUBLIC_SITE_URL=https://jjfcreando.com
# 1 shows the interim plates on the homepage hero and staging-flagged project images. Leave unset in production.
PUBLIC_STAGING=1
# Analytics (plan §9). Unset = nothing loads.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
# LeadConnector (GoHighLevel) v2 — Private Integration token + location, used by netlify/functions/lead.mjs
GHL_PIT=
GHL_LOCATION_ID=
# Reading the stored enquiries back at /api/leads (?format=csv for a spreadsheet). At least 24
# characters, or the endpoint stays closed. It unlocks names, phone numbers and email addresses:
# treat it as a password, keep it out of shared links, rotate it if it leaks.
#   openssl rand -hex 24
LEADS_TOKEN=
